{
  "name": "magi-review",
  "version": "0.2.0",
  "description": "Multi-persona AI code review system inspired by Evangelion MAGI",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:dist": "node scripts/smoke-dist.mjs"
  },
  "keywords": [
    "github-action",
    "code-review",
    "ai",
    "gemini",
    "magi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^0.123.0",
    "@google/genai": "^2.21.0",
    "minimatch": "^10.2.6",
    "openai": "^7.9.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
